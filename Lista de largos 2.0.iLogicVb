        "HR174	TUBO HR174	TUBO	A 36	1.0		20.0	33.276	1	HR174 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 33.276 lb | DISP" & vbLf & _
        "HR169	TUBO HR169	TUBO	A 36	1.0		20.0	342.952	1	HR169 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 342.952 lb | DISP" & vbLf & _
        "HR211	TUBO HR211	TUBO	A 36	1.0		20.0	307.813	1	HR211 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 307.813 lb | DISP" & vbLf & _
        "HR220	TUBO HR220	TUBO	A 36	1.0		20.0	42.071	1	HR220 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 42.071 lb | DISP" & vbLf & _
        "HR164	TUBO HR164	TUBO	A 36	1.0		20.0	261.976	1	HR164 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 261.976 lb | DISP" & vbLf & _
        "HR166	TUBO HR166	TUBO	A 36	1.0		20.0	60.874	1	HR166 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 60.874 lb | DISP" & vbLf & _
        "HR167	TUBO HR167	TUBO	A 36	1.0		20.0	9.126	1	HR167 | TUBO | A 36 | 1 in x 20 ft | esp N/D | 9.126 lb | DISP" & vbLf & _
        "HR212	TUBO HR212	TUBO	SSTL 304	1.0		20.0	266.588	1	HR212 | TUBO | SSTL 304 | 1 in x 20 ft | esp N/D | 266.588 lb | DISP" & vbLf & _
        "RED025	Varilla RED025	VARILLA	A 36	1.0		20.0	13.383	1	RED025 | VARILLA | A 36 | 1 in x 20 ft | esp N/D | 13.383 lb | DISP" & vbLf & _
        "RED027	Varilla RED027	VARILLA	A 36	1.0		20.0	30.112	1	RED027 | VARILLA | A 36 | 1 in x 20 ft | esp N/D | 30.112 lb | DISP" & vbLf & _
        "RED028	Varilla RED028	VARILLA	A 36	1.0		20.0	5.245	1	RED028 | VARILLA | A 36 | 1 in x 20 ft | esp N/D | 5.245 lb | DISP" & vbLf & _
        "RED024	Varilla RED024	VARILLA	A 36	1.0		20.0	7.528	1	RED024 | VARILLA | A 36 | 1 in x 20 ft | esp N/D | 7.528 lb | DISP" & vbLf & _
        "RED040	Varilla RED040	VARILLA	A 36	1.0		20.0	53.533	1	RED040 | VARILLA | A 36 | 1 in x 20 ft | esp N/D | 53.533 lb | DISP" & vbLf & _
        "RED035	Varilla RED035	VARILLA	SSTL 304	1.0		20.0	3.405	1	RED035 | VARILLA | SSTL 304 | 1 in x 20 ft | esp N/D | 3.405 lb | DISP" & vbLf & _
        "VIG047	Viga IPR 1	VIGA IPR	A 36	1.0		20.0	240.0	1	VIG047 | VIGA IPR | A 36 | 1 in x 20 ft | esp N/D | 240 lb | DISP" & vbLf & _
        "VIG044	Viga IPR 1	VIGA IPR	A 36	1.0		20.0	154.0	1	VIG044 | VIGA IPR | A 36 | 1 in x 20 ft | esp N/D | 154 lb | DISP" & vbLf & _
        "VIG033	Viga IPR 1	VIGA IPR	A 36	1.0		40.0	480.0	1	VIG033 | VIGA IPR | A 36 | 1 in x 40 ft | esp N/D | 480 lb | DISP"
' END_BIBLIOTECA_HERINOX_DATOS
    If String.IsNullOrWhiteSpace(datos) Then Return filas

    For Each linea As String In datos.Split(New String() {vbLf, vbCrLf}, StringSplitOptions.RemoveEmptyEntries)
        Dim texto As String = linea.Trim()
        If texto = "" Then Continue For

        Dim partes() As String = texto.Split(vbTab)
        If partes.Length < 2 Then Continue For

        Dim codigo As String = partes(0).Trim()
        Dim clasif As String = partes(1).Trim()
        If codigo = "" OrElse clasif = "" Then Continue For

        Dim fila As New CatalogoHerinoxFila With {
            .Codigo = codigo,
            .Clasificacion = clasif,
            .Perfil = If(partes.Length > 2, partes(2).Trim(), ""),
            .Material = If(partes.Length > 3, partes(3).Trim(), ""),
            .LargoFt = 0,
            .TextoComboLinea = ""
        }
        If partes.Length > 6 Then Double.TryParse(partes(6).Trim(), fila.LargoFt)
        If partes.Length > 9 Then
            fila.TextoComboLinea = partes(9).Trim()
        Else
            fila.TextoComboLinea = fila.TextoCombo()
        End If

        filas.Add(fila)
    Next

    If filas.Count > 0 Then
        CatalogoHerinoxEstado.FuenteUltimaCarga = "FALLBACK embebido (" & filas.Count.ToString() & " largos; revise Consulta_Herinox.py)"
    End If

    Return filas
End Function

Function CargarCatalogoHerinox(
    ByRef catalogoPorCombo As Dictionary(Of String, CatalogoHerinoxFila),
    Optional preferJsonPath As String = ""
) As List(Of String)

    catalogoPorCombo = New Dictionary(Of String, CatalogoHerinoxFila)(StringComparer.OrdinalIgnoreCase)
    Dim opciones As New List(Of String)

    For Each fila As CatalogoHerinoxFila In BibliotecaHerinoxObtenerFilas(preferJsonPath)
        Dim claveCombo As String = fila.TextoCombo()
        If Not catalogoPorCombo.ContainsKey(claveCombo) Then
            catalogoPorCombo.Add(claveCombo, fila)
            opciones.Add(claveCombo)
        End If
    Next

    opciones.Sort(StringComparer.OrdinalIgnoreCase)

    If Not opciones.Contains("No Clasificado") Then
        opciones.Add("No Clasificado")
    End If

    Return opciones
End Function

Function MaterialHerinoxEsValido(clasificacion As String) As Boolean
    If String.IsNullOrWhiteSpace(clasificacion) Then Return False
    Dim t As String = clasificacion.Trim()
    If String.Equals(t, "No Clasificado", StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(t, "No clasificado", StringComparison.OrdinalIgnoreCase) Then Return False
    If Not t.Contains("|") Then Return False
    Return True
End Function

Function ValidarMaterialesHerinoxObligatorios(lista As List(Of ComponentePerfil)) As String
    If lista Is Nothing OrElse lista.Count = 0 Then
        Return "No hay piezas en la lista para exportar."
    End If

    Dim faltantes As New List(Of String)
    For Each item As ComponentePerfil In lista
        If Not MaterialHerinoxEsValido(item.Clasificacion) Then
            faltantes.Add(item.Nombre)
        End If
    Next

    If faltantes.Count = 0 Then Return ""

    Dim detalle As String = String.Join(vbCrLf, faltantes.ToArray())
    Return "Debe seleccionar un material Herinox en cada fila (no puede quedar ""No Clasificado"")." & vbCrLf & vbCrLf &
           "Piezas sin material:" & vbCrLf & detalle
End Function

Function EscaparCsvCampo(valor As String) As String
    If valor Is Nothing Then Return ""
    If valor.Contains(",") OrElse valor.Contains("""") OrElse valor.Contains(vbCr) OrElse valor.Contains(vbLf) Then
        Return """" & valor.Replace("""", """""") & """"
    End If
    Return valor
End Function

Function GuardarCsvListaPerfiles(filePath As String, contenido As String) As String
    Dim intentos As Integer = 8
    Dim pausaMs As Integer = 450
    Dim ultimoError As String = ""
    Dim bytes() As Byte = System.Text.Encoding.UTF8.GetBytes(contenido)

    For i As Integer = 1 To intentos
        Try
            Using fs As New System.IO.FileStream(filePath, System.IO.FileMode.Create, System.IO.FileAccess.Write, System.IO.FileShare.None)
                fs.Write(bytes, 0, bytes.Length)
                fs.Flush()
            End Using
            Return ""
        Catch ex As System.IO.IOException
            ultimoError = ex.Message
            System.Threading.Thread.Sleep(pausaMs)
        Catch ex As Exception
            Return ex.Message
        End Try
    Next

    Dim rutaTmp As String = filePath & ".tmp"
    Try
        System.IO.File.WriteAllText(rutaTmp, contenido, System.Text.Encoding.UTF8)
        If System.IO.File.Exists(filePath) Then
            System.IO.File.Delete(filePath)
        End If
        System.IO.File.Move(rutaTmp, filePath)
        Return ""
    Catch ex2 As Exception
        Try
            If System.IO.File.Exists(rutaTmp) Then
                System.IO.File.Delete(rutaTmp)
            End If
        Catch
        End Try
        If ultimoError = "" Then
            Return ex2.Message
        End If
        Return ultimoError & vbCrLf & ex2.Message
    End Try
End Function

Function ColorNombrePorClasificacion(clasificacion As String) As String
    If String.IsNullOrWhiteSpace(clasificacion) Then Return ""
    Dim c As String = clasificacion.ToUpperInvariant()

    If c.Contains("NO CLASIFICADO") Then Return "Gray"

    ' Formato tarjetón: CODIGO | PERFIL perfil | MATERIAL | descripcion
    Dim partes() As String = clasificacion.Split("|"c)
    If partes.Length >= 2 Then
        Dim perfilSeg As String = partes(1).Trim().ToUpperInvariant()
        If perfilSeg.StartsWith("SOLERA") Then Return "Forest Green"
        If perfilSeg.StartsWith("CANAL") Then Return "Sky Blue"
        If perfilSeg.StartsWith("VIGA") Then Return "Red"
        If perfilSeg.StartsWith("PTR") Then Return "Yellow"
        If perfilSeg.StartsWith("ANGULO") OrElse perfilSeg.StartsWith("ÁNGULO") Then Return "Yellow"
        If perfilSeg.StartsWith("VARILLA") Then Return "Dark Gray"
        If perfilSeg.StartsWith("TUBO") Then Return "Gray"
    End If

    If c.StartsWith("SOLERA") Then Return "Forest Green"
    If c.StartsWith("CANAL") Then Return "Sky Blue"
    If c.StartsWith("VIGA") Then Return "Red"
    If c.StartsWith("PTR") Then Return "Yellow"
    If c.StartsWith("ÁNGULO") OrElse c.StartsWith("ANGULO") Then Return "Yellow"
    If c.Contains("VARILLA") Then Return "Dark Gray"

    Return "Gray"
End Function

