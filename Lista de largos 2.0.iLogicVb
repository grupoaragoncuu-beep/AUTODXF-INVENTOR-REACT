' Pilas UNDO (mismo patrón que Colorimetria Sub Assembly + Norman)
Public Class ListaLargosSelectionUndoRecord
    Public Property DocKey As String
    Public Property Occs As List(Of ComponentOccurrence)
End Class

Public Class ListaLargosClasificacionUndoRecord
    Public Property Perfil As ComponentePerfil
    Public Property OldClasificacion As String
End Class

Public Class MiniToolbarSelector

    Private _inventor As Inventor.Application
    Private _asmDoc As AssemblyDocument
    Private _asmDef As AssemblyComponentDefinition
    Private _interactEvents As InteractionEvents
    Private _selectEvents As SelectEvents
    Private _toolBar As MiniToolbar
    Private _stillSelecting As Boolean
    Private _selectedOccs As New List(Of ComponentOccurrence)
    Private _aparienciasOriginales As Dictionary(Of String, Asset)
    Private _appearanceAmarillo As Asset
    Private _selectionUndoStack As New Stack(Of ListaLargosSelectionUndoRecord)

    Public Sub New(app As Inventor.Application,
                   asmDoc As AssemblyDocument,
                   asmDef As AssemblyComponentDefinition,
                   aparienciasOriginales As Dictionary(Of String, Asset))

        _inventor = app
        _asmDoc = asmDoc
        _asmDef = asmDef
        _aparienciasOriginales = aparienciasOriginales
    End Sub

    Public ReadOnly Property SelectedOccurrences As List(Of ComponentOccurrence)
        Get
            Return _selectedOccs
        End Get
    End Property

    Public Sub Pick()

        _stillSelecting = True
        _appearanceAmarillo = BuscarOCopiarAppearanceLocal("Yellow")
        If _appearanceAmarillo Is Nothing Then
            _appearanceAmarillo = BuscarOCopiarAppearanceLocal("Amarillo")
        End If

        _interactEvents = _inventor.CommandManager.CreateInteractionEvents
        _selectEvents = _interactEvents.SelectEvents

        _selectEvents.ClearSelectionFilter()
        _selectEvents.AddSelectionFilter(SelectionFilterEnum.kAllEntitiesFilter)
        _selectEvents.SingleSelectEnabled = False

        AddHandler _selectEvents.OnSelect, AddressOf OnSelectOcc
        AddHandler _interactEvents.OnTerminate, AddressOf OnTerminateHandler

        _toolBar = _interactEvents.CreateMiniToolbar()

        _toolBar.Controls.AddNewLine()

        Dim btnUndoOp = _toolBar.Controls.AddButton("btnUndoOp", "⏪", "Deshacer ultima seleccion aplicada")
        AddHandler btnUndoOp.OnClick, AddressOf DeshacerUltimaSeleccion

        Dim btnSalir = _toolBar.Controls.AddButton("btnSalir", "Salir", "Terminar seleccion")
        AddHandler btnSalir.OnClick, AddressOf Salir

        _toolBar.ShowApply = False
        _toolBar.Visible = True

        _interactEvents.Start()

        Do While _stillSelecting
            _inventor.UserInterfaceManager.DoEvents()
        Loop

        If _interactEvents IsNot Nothing Then
            _interactEvents.Stop()
        End If

        If _toolBar IsNot Nothing Then
            _toolBar.Delete()
        End If
    End Sub

    Private Sub OnSelectOcc(JustSelectedEntities As ObjectsEnumerator,
                            SelectionDevice As SelectionDeviceEnum,
                            ModelPosition As Inventor.Point,
                            ViewPosition As Inventor.Point2d,
                            ByVal View As Inventor.View)

        If JustSelectedEntities Is Nothing OrElse JustSelectedEntities.Count = 0 Then Exit Sub

        For Each sel As Object In JustSelectedEntities

            Dim occ As ComponentOccurrence = ResolveOccurrence(sel)
            If occ Is Nothing Then Continue For

            AgregarPiezaYGemelosASeleccion(occ)
        Next
    End Sub

    Private Sub AgregarPiezaYGemelosASeleccion(occ As ComponentOccurrence)
        Dim docKey As String = ""
        Try
            docKey = occ.Definition.Document.FullFileName.ToLower()
        Catch
            Exit Sub
        End Try

        Dim occsMismoArchivo As List(Of ComponentOccurrence) = ObtenerOcurrenciasMismoArchivoLocal(docKey)
        Dim occClone As ComponentOccurrence
        Dim newlyAdded As New List(Of ComponentOccurrence)

        For Each occClone In occsMismoArchivo
            If Not _selectedOccs.Contains(occClone) Then
                _selectedOccs.Add(occClone)
                newlyAdded.Add(occClone)
            End If
        Next

        If newlyAdded.Count = 0 Then Exit Sub

        _selectionUndoStack.Push(New ListaLargosSelectionUndoRecord With {
            .DocKey = docKey,
            .Occs = newlyAdded
        })

        PintarFamiliaAmarilloLocal(occ)
    End Sub

    Private Sub DeshacerUltimaSeleccion()
        If _selectionUndoStack Is Nothing OrElse _selectionUndoStack.Count = 0 Then
            _inventor.StatusBarText = "No hay cambios para deshacer."
            Exit Sub
        End If

        Dim rec As ListaLargosSelectionUndoRecord = _selectionUndoStack.Pop()
        If rec Is Nothing OrElse rec.Occs Is Nothing Then Exit Sub

        Dim occClone As ComponentOccurrence
        For Each occClone In rec.Occs
            Try
                If _selectedOccs.Contains(occClone) Then
                    _selectedOccs.Remove(occClone)
                End If
                RestaurarAparienciaLocalDesdeBackup(occClone)
            Catch
            End Try
        Next

        Try
            _inventor.ActiveView.Update()
        Catch
        End Try

        _inventor.StatusBarText = "Se deshizo la ultima seleccion aplicada."
    End Sub

    Private Sub RestaurarAparienciaLocalDesdeBackup(occ As ComponentOccurrence)
        Try
            Dim clave As String = occ.Definition.Document.FullFileName.ToLower() & "|" & occ.Name
            If _aparienciasOriginales.ContainsKey(clave) Then
                Dim original As Asset = _aparienciasOriginales(clave)
                If original IsNot Nothing Then
                    Dim dn As String = ""
                    Try
                        dn = original.DisplayName.ToLower()
                    Catch
                    End Try
                    If dn <> "yellow" AndAlso dn <> "amarillo" AndAlso Not dn.Contains("yellow") AndAlso Not dn.Contains("amarillo") Then
                        occ.Appearance = original
                        Return
                    End If
                End If
            End If
            Try
                occ.AppearanceSourceType = AppearanceSourceTypeEnum.kPartAppearance
            Catch
            End Try
            Try
                occ.Appearance = Nothing
            Catch
            End Try
        Catch
        End Try
    End Sub

    Private Function ResolveOccurrence(sel As Object) As ComponentOccurrence
        Dim occ As ComponentOccurrence = TryCast(sel, ComponentOccurrence)
        If occ IsNot Nothing Then Return occ

        Try
            Return DirectCast(sel, FaceProxy).ContainingOccurrence
        Catch
        End Try

        Try
            Return DirectCast(sel, EdgeProxy).ContainingOccurrence
        Catch
        End Try

        Try
            Return DirectCast(sel, VertexProxy).ContainingOccurrence
        Catch
        End Try

        Try
            Return DirectCast(sel, SurfaceBodyProxy).ContainingOccurrence
        Catch
        End Try

        Return Nothing
    End Function

    Private Sub PintarFamiliaAmarilloLocal(occ As ComponentOccurrence)
        If _appearanceAmarillo Is Nothing Then Exit Sub

        Dim docKey As String = ""
        Try
            docKey = occ.Definition.Document.FullFileName.ToLower()
        Catch
            Exit Sub
        End Try

        Dim occsMismoArchivo As List(Of ComponentOccurrence) = ObtenerOcurrenciasMismoArchivoLocal(docKey)
        Dim occClone As ComponentOccurrence

        For Each occClone In occsMismoArchivo
            GuardarAparienciaOriginalLocal(occClone)
            Try
                occClone.AppearanceSourceType = AppearanceSourceTypeEnum.kOverrideAppearance
                occClone.Appearance = _appearanceAmarillo
            Catch
                Try
                    occClone.Appearance = _appearanceAmarillo
                Catch
                End Try
            End Try
        Next

        Try
            _inventor.ActiveView.Update()
        Catch
        End Try
    End Sub

    Private Sub GuardarAparienciaOriginalLocal(occ As ComponentOccurrence)
        Try
            Dim clave As String = occ.Definition.Document.FullFileName.ToLower() & "|" & occ.Name
            If Not _aparienciasOriginales.ContainsKey(clave) Then
                _aparienciasOriginales.Add(clave, occ.Appearance)
            End If
        Catch
        End Try
    End Sub

    Private Function BuscarOCopiarAppearanceLocal(nombreAppearance As String) As Asset
        Dim oAsset As Asset = Nothing
        Dim oLib As AssetLibrary
        Dim oLibAsset As Asset = Nothing

        Try
            For Each oAsset In _asmDoc.Assets
                Try
                    If oAsset.AssetType = AssetTypeEnum.kAssetTypeAppearance Then
                        If String.Compare(oAsset.DisplayName, nombreAppearance, True) = 0 Then
                            Return oAsset
                        End If
                        If String.Compare(oAsset.Name, nombreAppearance, True) = 0 Then
                            Return oAsset
                        End If
                    End If
                Catch
                End Try
            Next
        Catch
        End Try

        Try
            For Each oLib In _inventor.AssetLibraries
                Try
                    oLibAsset = oLib.AppearanceAssets.Item(nombreAppearance)
                    If oLibAsset IsNot Nothing Then
                        Return oLibAsset.CopyTo(_asmDoc)
                    End If
                Catch
                End Try
            Next
        Catch
        End Try

        Return Nothing
    End Function

    Private Function ObtenerOcurrenciasMismoArchivoLocal(docKey As String) As List(Of ComponentOccurrence)
        Dim lista As New List(Of ComponentOccurrence)
        Dim occ As ComponentOccurrence

        For Each occ In _asmDef.Occurrences.AllLeafOccurrences
            Try
                If occ.DefinitionDocumentType = kPartDocumentObject Then
                    If occ.Definition.Document.FullFileName.ToLower() = docKey Then
                        lista.Add(occ)
                    End If
                End If
            Catch ex As Exception
            End Try
        Next

        Return lista
    End Function

    Private Sub OnTerminateHandler()
        _stillSelecting = False
    End Sub

    Private Sub Salir()
        _stillSelecting = False
    End Sub

End Class
' Función para mostrar tabla editable antes de exportar
' OK = continuar al CSV | Retry = seguir añadiendo largos | Cancel = salir
Function MostrarTablaClasificacion(
    lista As List(Of ComponentePerfil),
    clasificaciones As List(Of String),
    selectedComps As ObjectCollection,
    oAsmDef As AssemblyComponentDefinition,
    aparienciasOriginales As Dictionary(Of String, Asset)
) As DialogResult
    Dim frm As New System.Windows.Forms.Form With {
        .Text = "Resumen de perfiles antes de exportar CSV",
        .Width = 1040,
        .Height = 560,
        .CancelButton = Nothing
    }
    Dim bindingList As New BindingList(Of ComponentePerfil)
    For Each perfilItem As ComponentePerfil In lista
        bindingList.Add(perfilItem)
    Next
    Dim dgv As New DataGridView With {
        .Dock = DockStyle.Fill,
        .AutoGenerateColumns = False,
        .AllowUserToAddRows = False,
        .SelectionMode = DataGridViewSelectionMode.FullRowSelect,
        .MultiSelect = False,
        .DataSource = New BindingSource(bindingList, Nothing)
    }
    dgv.Columns.Add(New DataGridViewTextBoxColumn() With {.HeaderText = "Archivo .ipt", .DataPropertyName = "Nombre", .ReadOnly = True, .Width = 180})
    Dim comboCol As New DataGridViewComboBoxColumn With {
        .HeaderText = "Material Herinox (código | perfil | material | descripción)",
        .DataPropertyName = "Clasificacion",
        .DataSource = clasificaciones,
        .FlatStyle = FlatStyle.Flat,
        .Width = 420
    }
    dgv.Columns.Add(comboCol)
    dgv.Columns.Add(New DataGridViewTextBoxColumn() With {.HeaderText = "Largo (in)", .DataPropertyName = "Largo", .ReadOnly = True})
    dgv.Columns.Add(New DataGridViewTextBoxColumn() With {.HeaderText = "Cantidad (gemelos)", .DataPropertyName = "Cantidad", .ReadOnly = True, .Width = 110})
    Dim comboProceso As New DataGridViewComboBoxColumn With {
        .HeaderText = "Proceso",
        .DataPropertyName = "Proceso",
        .DataSource = OpcionesProcesoLargo(),
        .FlatStyle = FlatStyle.Flat,
        .Width = 210
    }
    dgv.Columns.Add(comboProceso)

    Dim undoClasif As New Stack(Of ListaLargosClasificacionUndoRecord)
    Dim editingPerfil As ComponentePerfil = Nothing
    Dim editingOldClasif As String = ""
    Const idxColClasif As Integer = 1

    AddHandler dgv.CellBeginEdit,
        Sub(sender, e)
            If e.ColumnIndex <> idxColClasif Then Return
            editingPerfil = TryCast(dgv.Rows(e.RowIndex).DataBoundItem, ComponentePerfil)
            If editingPerfil IsNot Nothing Then
                editingOldClasif = editingPerfil.Clasificacion
            End If
        End Sub

    AddHandler dgv.CellEndEdit,
        Sub(sender, e)
            If e.ColumnIndex <> idxColClasif Then Return
            If editingPerfil Is Nothing Then Return
            Dim nuevo As String = editingPerfil.Clasificacion
            If nuevo <> editingOldClasif Then
                undoClasif.Push(New ListaLargosClasificacionUndoRecord With {
                    .Perfil = editingPerfil,
                    .OldClasificacion = editingOldClasif
                })
            End If
            editingPerfil = Nothing
            editingOldClasif = ""
        End Sub

    Dim panelBtns As New Panel With {.Dock = DockStyle.Bottom, .Height = 48}
    Dim btnUndo As New Button With {
        .Text = "⏪ Deshacer",
        .Width = 120,
        .Height = 32,
        .Dock = DockStyle.Left
    }
    Dim btnEliminar As New Button With {
        .Text = "Eliminar",
        .Width = 100,
        .Height = 32,
        .Dock = DockStyle.Left
    }
    Dim panelDer As New Panel With {
        .Dock = DockStyle.Right,
        .Width = 360,
        .Height = 48
    }
    Dim btnOK As New Button With {
        .Text = "Continuar",
        .Width = 130,
        .Height = 32,
        .Dock = DockStyle.Right
    }
    Dim btnSeguir As New Button With {
        .Text = "Seguir añadiendo largos",
        .Width = 210,
        .Height = 32,
        .Dock = DockStyle.Right
    }

    AddHandler btnUndo.Click,
        Sub(sender, e)
            If undoClasif.Count = 0 Then
                MessageBox.Show("No hay cambios de clasificacion para deshacer.", "Lista de largos",
                                MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return
            End If
            Dim rec As ListaLargosClasificacionUndoRecord = undoClasif.Pop()
            If rec IsNot Nothing AndAlso rec.Perfil IsNot Nothing Then
                rec.Perfil.Clasificacion = rec.OldClasificacion
                dgv.Refresh()
            End If
        End Sub

    AddHandler btnEliminar.Click,
        Sub(sender, e)
            If dgv.CurrentRow Is Nothing Then
                MessageBox.Show("Seleccione una fila de la tabla para eliminar.", "Lista de largos",
                                MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return
            End If
            Dim perfil As ComponentePerfil = TryCast(dgv.CurrentRow.DataBoundItem, ComponentePerfil)
            If perfil Is Nothing Then Return

            Dim confirmar As DialogResult = MessageBox.Show(
                "Quitar de la lista: " & perfil.Nombre & " ?" & vbCrLf &
                "Se quitara el amarillo de esa pieza en el ensamble.",
                "Eliminar perfil",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question)
            If confirmar <> DialogResult.Yes Then Return

            QuitarPerfilDeListaYSeleccion(perfil, lista, bindingList, selectedComps, oAsmDef, aparienciasOriginales)

            If lista.Count = 0 Then
                MessageBox.Show(
                    "No quedan perfiles en la lista." & vbCrLf &
                    "Use 'Seguir añadiendo largos' o cierre la ventana.",
                    "Lista de largos",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information)
            End If
        End Sub

    AddHandler btnSeguir.Click,
        Sub(sender, e)
            frm.DialogResult = DialogResult.Retry
            frm.Close()
        End Sub

    AddHandler btnOK.Click,
        Sub(sender, e)
            Dim msgValidacion As String = ValidarMaterialesHerinoxObligatorios(lista)
            If msgValidacion <> "" Then
                MessageBox.Show(
                    msgValidacion,
                    "Material Herinox obligatorio",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)
                Return
            End If
            frm.DialogResult = DialogResult.OK
            frm.Close()
        End Sub
    AddHandler frm.FormClosing,
        Sub(sender, e)
            If frm.DialogResult = DialogResult.None Then
                frm.DialogResult = DialogResult.Cancel
            End If
            If frm.DialogResult <> DialogResult.OK AndAlso frm.DialogResult <> DialogResult.Retry Then
                RestaurarAparienciasSeleccion(aparienciasOriginales, oAsmDef)
            End If
        End Sub
    panelDer.Controls.Add(btnOK)
    panelDer.Controls.Add(btnSeguir)
    panelBtns.Controls.Add(panelDer)
    panelBtns.Controls.Add(btnUndo)
    panelBtns.Controls.Add(btnEliminar)
    frm.Controls.Add(panelBtns)
    frm.Controls.Add(dgv)
    Return frm.ShowDialog()
End Function
